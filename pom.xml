<?xml version="1.0" encoding="UTF-8"?>
<!-- POM Reference：https://maven.apache.org/pom.html -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- 4.0.0 是目前唯一支持的 POM 版本，且始终是必需的 -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 项目继承：https://maven.apache.org/guides/introduction/introduction-to-the-pom.html#Project_Inheritance -->
    <!-- 项目聚合：https://maven.apache.org/guides/introduction/introduction-to-the-pom.html#project-aggregation -->
    <parent>
        <groupId>org.springframework.cloud</groupId>
        <!-- https://github.com/spring-cloud/spring-cloud-build/blob/main/pom.xml -->
        <artifactId>spring-cloud-build</artifactId>
        <version>5.0.2</version>
        <relativePath/>
    </parent>

    <!-- The Basics：https://maven.apache.org/pom.html#The_Basics -->
    <groupId>org.ljh</groupId>
    <artifactId>epitome</artifactId>
    <!-- 语义化版本：https://semver.org/lang/zh-CN/ -->
    <version>1.0.1-SNAPSHOT</version>
    <!-- pom, jar（默认）, maven-plugin, ejb, war, ear, rar -->
    <packaging>pom</packaging>

    <name>epitome</name>
    <description>The Java Full-Stack Encyclopedia</description>
    <url>https://github.com/Apparition2018/epitome</url>

    <scm>
        <url>https://github.com/Apparition2018/epitome</url>
        <connection>scm:git:git://github.com/Apparition2018/epitome.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/Apparition2018/epitome.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <developers>
        <developer>
            <id>ljh</id>
            <email>88850180@163.com</email>
        </developer>
    </developers>

    <!-- 项目插值和变量：https://maven.apache.org/guides/introduction/introduction-to-the-pom.html#project-interpolation-and-variables -->
    <!-- settings.xml 中 <profile/> 可设置 <properties/> -->
    <properties>
        <!-- https://mvnrepository.com/artifact/com.alibaba/druid-spring-boot-starter -->
        <druid-spring-boot-4-starter.version>1.2.28</druid-spring-boot-4-starter.version>
        <!-- https://mvnrepository.com/artifact/org.mybatis.dynamic-sql/mybatis-dynamic-sql -->
        <mybatis-dynamic-sql.version>2.0.0</mybatis-dynamic-sql.version>
        <!-- https://mvnrepository.com/artifact/com.github.pagehelper/pagehelper-spring-boot-starter -->
        <pagehelper-spring-boot-starter.version>4.1.1</pagehelper-spring-boot-starter.version>
        <!-- https://mvnrepository.com/artifact/com.baomidou/mybatis-plus-spring-boot4-starter -->
        <mybatis-plus-spring-boot4-starter.version>3.5.17</mybatis-plus-spring-boot4-starter.version>
        <!-- https://mvnrepository.com/artifact/com.h2database/h2 -->
        <h2.version>2.4.240</h2.version>
        <!-- https://mvnrepository.com/artifact/org.mybatis.generator/mybatis-generator-maven-plugin -->
        <mybatis-generator-maven-plugin.version>2.0.0</mybatis-generator-maven-plugin.version>
        <!-- Caffeine：caffeine 与 caffeine:jcache 需同版本发布，统一管理避免 SPI 与核心版本不一致 -->
        <caffeine.version>3.2.4</caffeine.version>
        <!-- https://mvnrepository.com/artifact/org.eclipse.paho/org.eclipse.paho.client.mqttv3 -->
        <org.eclipse.paho.client.mqttv3.version>1.2.5</org.eclipse.paho.client.mqttv3.version>
        <!-- https://mvnrepository.com/artifact/org.apache.rocketmq/rocketmq-spring-boot-starter -->
        <rocketmq-spring-boot-starter.version>2.3.6</rocketmq-spring-boot-starter.version>
        <!-- https://mvnrepository.com/artifact/org.apache.rocketmq/rocketmq-test -->
        <rocketmq.version>5.5.0</rocketmq.version>

        <!-- commons -->
        <!-- https://mvnrepository.com/artifact/org.apache.commons/commons-configuration2 -->
        <commons-configuration2.version>2.15.1</commons-configuration2.version>
        <!-- https://mvnrepository.com/artifact/io.minio/minio -->
        <minio.version>9.0.3</minio.version>
        <!-- https://mvnrepository.com/artifact/cn.hutool/hutool-all -->
        <hutool.version>5.8.46</hutool.version>
        <!-- https://mvnrepository.com/artifact/org.apache.poi/poi -->
        <poi.version>5.5.1</poi.version>
        <!-- https://mvnrepository.com/artifact/org.springdoc/springdoc-openapi-starter-webmvc-ui -->
        <springdoc-openapi-starter.version>3.0.3</springdoc-openapi-starter.version>

        <!-- dependencies -->
        <!-- https://mvnrepository.com/artifact/commons-net/commons-net -->
        <commons-net.version>3.13.0</commons-net.version>
        <!-- https://mvnrepository.com/artifact/org.apache.tika/tika-core -->
        <tika.version>3.3.1</tika.version>
        <!-- https://mvnrepository.com/artifact/org.apache.axis2/axis2 -->
        <axis2.version>2.0.1</axis2.version>
        <!-- https://mvnrepository.com/artifact/org.apache.curator/curator-recipes -->
        <curator.version>5.9.0</curator.version>
        <!-- https://mvnrepository.com/artifact/io.protostuff/protostuff-core -->
        <protostuff.version>1.8.0</protostuff.version>
        <!-- https://mvnrepository.com/artifact/com.alibaba/fastjson -->
        <!-- https://mvnrepository.com/artifact/com.alibaba.fastjson2/fastjson2 -->
        <fastjson.version>2.0.62</fastjson.version>
        <!-- https://mvnrepository.com/artifact/com.google.code.gson/gson -->
        <gson.version>2.14.0</gson.version>
        <!-- https://mvnrepository.com/artifact/com.google.zxing/core -->
        <zxing.version>3.5.4</zxing.version>
        <!-- https://mvnrepository.com/artifact/com.itextpdf/itext-core -->
        <itext.version>9.7.1</itext.version>
        <!-- https://mvnrepository.com/artifact/org.eclipse.paho/org.eclipse.paho.mqttv5.client -->
        <org.eclipse.paho.mqttv5.client.version>1.2.5</org.eclipse.paho.mqttv5.client.version>
        <!-- https://mvnrepository.com/artifact/com.github.mwiede/jsch -->
        <jsch.version>2.28.4</jsch.version>
        <!-- https://mvnrepository.com/artifact/com.github.oshi/oshi-core -->
        <oshi.version>7.4.0</oshi.version>
    </properties>

    <modules>
        <module>legacy</module>
        <module>commons</module>
        <module>dependencies</module>
        <module>spring-boot</module>
        <module>spring-cloud</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>org.ljh</groupId>
            <artifactId>commons</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <!-- 依赖管理：https://maven.apache.org/pom.html#dependency-management -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-4-starter</artifactId>
                <version>${druid-spring-boot-4-starter.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.pagehelper</groupId>
                <artifactId>pagehelper-spring-boot-starter</artifactId>
                <version>${pagehelper-spring-boot-starter.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis.dynamic-sql</groupId>
                <artifactId>mybatis-dynamic-sql</artifactId>
                <version>${mybatis-dynamic-sql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus-spring-boot4-starter.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>jcache</artifactId>
                <version>${caffeine.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq-spring-boot-starter.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-test</artifactId>
                <version>${rocketmq.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.eclipse.paho</groupId>
                <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
                <version>${org.eclipse.paho.client.mqttv3.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Build Settings：https://maven.apache.org/pom.html#Build_Settings -->
    <build>
        <finalName>${project.artifactId}</finalName>
        <directory>target</directory>

        <!-- Available Plugins：https://maven.apache.org/plugins/index.html -->
        <!-- <plugins></plugins> -->

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                            </path>
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-autoconfigure-processor</artifactId>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- Resources：指定项目资源位置
                https://maven.apache.org/pom.html#resources -->
        <!-- spring-boot-starter-parent 的 resources
            https://stackoverflow.com/questions/60041457/spring-boot-starter-parent-resources-includes-excludes-explained -->
        <!-- <resources/> -->
    </build>

    <!-- Environment Settings：https://maven.apache.org/pom.html#Environment_Settings -->
    <!-- 仓库：Maven 首先尝试使用指定 artifact 的本地副本。如果本地仓库不存在该 artifact，将尝试从远程仓库下载。
                <repository/> 指定要搜索的备用仓库。Maven 默认会搜索 central(https://repo.maven.apache.org/maven2/) 仓库
                https://maven.apache.org/pom.html#repositories -->
    <repositories>
        <repository>
            <id>central</id>
            <!-- public 是 “聚合版”仓库（包含 central + jcenter 等） -->
            <!-- <url>https://maven.aliyun.com/repository/central</url> -->
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <!-- 插件仓库：https://maven.apache.org/pom.html#plugin-repositories -->
    <pluginRepositories>
        <pluginRepository>
            <id>aliyunmaven</id>
            <url>https://maven.aliyun.com/repository/public</url>
        </pluginRepository>
    </pluginRepositories>

    <!-- 发布管理：https://maven.apache.org/pom.html#distribution-management -->
    <!-- <distributionManagement/> -->

    <!-- Profiles：项目根据构建环境更改设置
        https://maven.apache.org/pom.html#profiles -->
    <!-- <profiles></profiles> -->
</project>
