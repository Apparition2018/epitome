    <build>
        <plugins>
            <!-- maven-surefire-plugin: Maven 默认单元测试执行器，绑定 test 阶段，按命名约定（*Test.java 等）发现并运行测试，结果写入 target/surefire-reports/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 让某些需要 Agent 支持的测试功能（如 Mock 静态方法）能够正常执行 -->
                    <argLine>
                        -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${byte-buddy.version}/byte-buddy-agent-${byte-buddy.version}.jar
                    </argLine>
                    <!-- skipTests: 跳过测试执行（测试代码仍编译），仅对 Maven 构建生效，IDE 里右键运行 @Test 不受影响 -->
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>

            <!-- maven-jar-plugin
                http://maven.apache.org/plugins/maven-jar-plugin/
                https://maven.apache.org/plugins/maven-assembly-plugin/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <!-- http://maven.apache.org/shared/maven-archiver/index.html -->
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <useUniqueVersions>false</useUniqueVersions>
                            <classpathPrefix>lib/</classpathPrefix>
                            <mainClass>${basedir}/springboot.EpitomeApplication</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

